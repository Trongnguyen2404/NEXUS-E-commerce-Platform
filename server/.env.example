# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port the API listens on. Swagger will be at http://localhost:$PORT/api/docs
PORT=3000

# Set to "production" on a real deployment. This switches on Secure cookies,
# turns OFF Swagger, and hides internal error details from API responses.
NODE_ENV=development

# PostgreSQL connection string.
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# When running through docker-compose, use the service name as the host:
#   postgresql://postgres:postgres@postgres:5432/nexus?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexus?schema=public

# Comma-separated list of origins allowed to call the API with credentials.
# Must include the exact origin of the frontend — wildcards do not work once
# cookies are involved.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Secrets for signing JWTs. Use two DIFFERENT random strings.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_REFRESH_SECRET=replace-me-with-a-different-long-random-string

# Access token lifetime. The refresh token is fixed at 7 days.
JWT_EXPIRES_IN=15m

# Stripe secret key — Dashboard > Developers > API keys (starts with sk_test_).
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Stripe webhook signing secret (starts with whsec_). Without it the webhook
# endpoint returns 500 and paid orders will never be marked as paid.
# Local development:
#   stripe listen --forward-to localhost:3000/api/v1/payments/webhook
# Production: Dashboard > Developers > Webhooks > your endpoint > signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_signing_secret_here

# Where the frontend lives. Used to build the links inside emails (password
# reset, order updates). Defaults to the first entry of ALLOWED_ORIGINS.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Email (optional)
#
# Leave ALL of SMTP_HOST/SMTP_USER/SMTP_PASS blank and the app falls back to an
# Ethereal test inbox: nothing is delivered, but every message is logged with a
# preview URL. That is enough to exercise password reset with no signup.
#
# Gmail: enable 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords
# Paste the 16 characters below — spaces are stripped automatically.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM="NEXUS <your-address@gmail.com>"

# ---------------------------------------------------------------------------
# Image uploads (optional)
#
# Leave CLOUDINARY_URL blank and uploads are written to ./uploads and served by
# this process — no signup needed, works offline. Good enough for development,
# but NOT for deployment: Render, Vercel and Fly all throw the filesystem away
# on every deploy, so the images would vanish on your next push.
#
# For anything deployed, sign up (free, no card) at cloudinary.com and copy the
# whole connection string from Dashboard > API Keys. It looks like:
#   cloudinary://123456789012345:AbCdEf...@your-cloud-name
# It contains your API secret — treat it like a password.
# ---------------------------------------------------------------------------
CLOUDINARY_URL=

# Only used by the local driver: where files are written, and the base URL the
# browser should use to fetch them back. The URL must be absolute — the
# frontend is a different origin, so a relative path would resolve against it.
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:3000

# Credentials for the first ADMIN account, created by `npm run seed`.
# Change the password before seeding anything you expose to the internet.
SEED_ADMIN_EMAIL=admin@nexus.local
SEED_ADMIN_PASSWORD=Admin@12345

# ---------------------------------------------------------------------------
# Checkout pricing. All server-side — the client never sends a price.
# ---------------------------------------------------------------------------
# Flat shipping charged below the free-shipping threshold.
SHIPPING_FLAT_FEE=9.99
# Spend this much (after any discount) and shipping is free.
FREE_SHIPPING_THRESHOLD=100
# 0.08 = 8%. Applied to discounted goods only, not to the shipping line.
TAX_RATE=0.08

# ---------------------------------------------------------------------------
# Crawlers.
# ---------------------------------------------------------------------------
# Public origin of the storefront, used to build absolute URLs in the sitemap
# served at /api/v1/sitemap.xml. Not the API's own origin.
PUBLIC_SITE_URL=http://localhost:5173

# Currency Stripe charges in. The client can no longer choose it — a client-set
# zero-decimal currency (vnd, jpy) against a fixed x100 conversion let a buyer
# settle a $100 order for about $0.38. Lowercase ISO code.
PAYMENT_CURRENCY=usd
