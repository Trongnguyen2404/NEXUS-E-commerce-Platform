# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
#   cp .env.example .env
#
# Only VITE_-prefixed variables reach the browser — and everything here IS
# shipped in the bundle, so never put a secret in this file.
# ---------------------------------------------------------------------------

# Base URL of the API, including the /api/v1 prefix and no trailing slash.
VITE_API_URL=http://localhost:3000/api/v1

# Stripe PUBLISHABLE key (starts with pk_test_), not the secret key.
# Dashboard > Developers > API keys
VITE_STRIPE_PUBLIC_KEY=pk_test_your_publishable_key_here
